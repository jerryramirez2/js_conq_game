
let arr = ['3-H','10-C','5-S','A-D','7-S','10-C','5-H','K-D'];
arr = [3,10,5,1,7,10,5,12];

for (let i = 0; i < arr.length; i++) {
    let curr = arr[i];
    let smallestFound;
    let index;
    let foundSmaller = false;
    for (let j = i + 1; j < arr.length; j++) {
        console.log(`Comparing ${curr} and ${arr[j]}`)
        if (curr > arr[j]) {
            smallestFound = arr[j];
            console.log(smallestFound)
            index = j;
            foundSmaller = true;
        }
    }
    
    if (foundSmaller) {
        let temp = arr[i];
        arr[i] = smallestFound;
        arr[index] = temp;
    }
}

